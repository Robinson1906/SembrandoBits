# Ejemplo de variables de entorno
# Copia este archivo a .env y completa MONGO_URI

# URI de MongoDB Atlas o servicio local
MONGO_URI=mongodb+srv://usuario:password@cluster.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Puerto interno del backend (no cambiar salvo necesidad)
PORT=8860
BIND_HOST=0.0.0.0
FLASK_DEBUG=0
ALLOW_START_WITHOUT_DB=1

# Reintentos de conexión a la base de datos
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY=5
